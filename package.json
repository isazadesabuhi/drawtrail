{
  "name": "drawtrail",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@drawtrail/web --",
    "build": "npm run build --workspace=@drawtrail/web",
    "build:e2e": "node tools/build-e2e.mjs",
    "start": "npm run start --workspace=@drawtrail/web",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:docs": "node tools/check-backlog.mjs",
    "typecheck": "tsc -p packages/types && tsc -p packages/validation && tsc -p packages/geo-utils && tsc -p packages/api-client && tsc -p packages/jobs && tsc -p apps/web && tsc -p apps/worker && tsc -p tsconfig.tools.json",
    "test": "vitest run --configLoader runner",
    "test:e2e": "playwright test",
    "test:e2e:dev": "node tools/test-dev.mjs",
    "routing:up": "docker compose up -d valhalla",
    "routing:down": "docker compose stop valhalla",
    "routing:health": "node tools/check-valhalla.mjs --wait",
    "test:routing:integration": "node tools/test-routing-integration.mjs",
    "test:generation:integration": "node tools/test-generation-integration.mjs",
    "test:generation:jobs:integration": "node tools/test-generation-jobs-integration.mjs",
    "jobs:up": "docker compose up -d postgres redis",
    "jobs:down": "docker compose stop postgres redis",
    "db:migrate": "node --env-file-if-exists=.env tools/migrate.mjs up",
    "db:migrate:down": "node --env-file-if-exists=.env tools/migrate.mjs down",
    "worker": "npm run start --workspace=@drawtrail/worker",
    "bench:generation:compare": "node tools/compare-route-algorithms.mjs",
    "check": "npm run check:docs && npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "bullmq": "^6.6.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.10",
    "ioredis": "^6.0.0",
    "jsdom": "29.0.1",
    "pg": "^8.23.1",
    "prettier": "3.8.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.2"
  }
}
