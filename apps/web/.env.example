# Server-only service configuration; never NEXT_PUBLIC_.
VALHALLA_URL=http://127.0.0.1:8002
# Optional shared key when the hosted routing service is behind the DrawTrail routing gateway.
# VALHALLA_API_KEY=replace-with-a-random-secret-of-at-least-32-characters
# For a low-volume public portfolio deployment, Valhalla's shared demo may be used subject to fair use.
# VALHALLA_URL=https://valhalla1.openstreetmap.de
# VALHALLA_CLIENT_ID=drawtrail.vercel.app
DATABASE_URL=postgres://drawtrail:drawtrail@127.0.0.1:5432/drawtrail
REDIS_URL=redis://127.0.0.1:6379
WORKER_CONCURRENCY=2

# Optional in `next dev`: defaults to OSM standard raster tiles for interactive development.
# Required together for a configured production map. No demo tiles default in production.
# Use a provider/self-hosted style with terms suitable for your intended traffic.
# NEXT_PUBLIC_MAP_STYLE_URL=https://your-map-host.example/style.json
# NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors · Your map provider
